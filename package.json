{
	"name": "ftf",
	"version": "1.0.0",
	"description": "Standalone Express server for QRCP – transfer files over Wi-Fi via QR code",
	"main": "dist/server.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/server.js",
		"dev": "ts-node-dev --respawn --transpile-only src/server.ts",
		"receive": "ts-node --transpile-only src/server.ts receive",
		"send": "ts-node --transpile-only src/server.ts send"
	},
	"dependencies": {
		"archiver": "^7.0.1",
		"express": "^4.19.2",
		"multer": "^1.4.5-lts.1",
		"open": "^8.4.2",
		"qrcode": "^1.5.4",
		"qrcode-terminal": "^0.12.0"
	},
	"devDependencies": {
		"@types/archiver": "^7.0.0",
		"@types/express": "^4.17.21",
		"@types/multer": "^1.4.11",
		"@types/node": "^20.14.0",
		"@types/qrcode": "^1.5.6",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.4.5"
	}
}
